# PayPal Sandbox credentials, can be obtained from developer.paypal.com
# The sandbox app needs the Invoicing and Transaction search features enabled.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# Optional: AG Studio licence key for /dashboard.
AG_STUDIO=

# The AG Studio AI assistant on /dashboard runs on Gemini (aistudio.google.com/apikey).
# If blank, the assistant is hidden.
GEMINI_API_KEY=

# Optional: comma-separated Gemini model ids, tried in order when one is busy or out of quota.
# If blank: gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.8-flash
GEMINI_MODELS=
